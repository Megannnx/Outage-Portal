# ── Core ──
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://portal:CHANGE_ME@db:5432/portal
DATABASE_SSL=false
PUBLIC_BASE_URL=https://outages.atec.co.za
# 32 random bytes, base64:  openssl rand -base64 32
APP_ENCRYPTION_KEY=
DISPLAY_TIMEZONE=Africa/Johannesburg
NODE_ENV=production
PORTAL_DOMAIN=outages.atec.co.za
WEB_BIND=127.0.0.1
RETENTION_RAW_EVENT_DAYS=180
RETENTION_JOB_DAYS=30

# ── Delivery: "capture" (demo/test, nothing leaves) or "live" ──
DELIVERY_MODE=capture

# Residents/clients — ATEC client-base communications API (see docs/INTEGRATIONS.md)
CLIENT_API_URL=
CLIENT_API_TOKEN=
CLIENT_API_TIMEOUT_MS=15000
CLIENT_API_WEBHOOK_SECRET=

# ISPs + internal notifications — SMTP relay
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ATEC Network Operations <outages@atec.co.za>"
SMTP_REPLY_TO=support@atec.co.za
SMTP_MESSAGE_ID_DOMAIN=outages.atec.co.za
# One mailbox per network: ISP notices for a site are sent from its network's account.
# SMTP_<NETWORK>_* overrides the shared SMTP_* value above (e.g. a different host).
SMTP_FSN_USER=noreply@fibresuburb.co.za
SMTP_FSN_PASSWORD=
SMTP_FSN_FROM="Fibre Suburb Network Operations <noreply@fibresuburb.co.za>"
SMTP_FMAS_USER=noreply@fmas.co.za
SMTP_FMAS_PASSWORD=
SMTP_FMAS_FROM="FMAS Network Operations <noreply@fmas.co.za>"
BOUNCE_WEBHOOK_TOKEN=
# Optional bounce-mailbox processor (scripts/bounce-processor.ts)
BOUNCE_IMAP_HOST=
BOUNCE_IMAP_USER=
BOUNCE_IMAP_PASSWORD=

# Extra addresses for urgent dispatch emails (comma-separated)
DISPATCH_EMAILS=

# ── Monitoring ingestion ──
# openssl rand -hex 32
INGEST_TOKEN_NETXMS=
INGEST_TOKEN_GENERIC=
# Optional: only accept ingestion from these IPs (NetXMS server)
INGEST_ALLOWED_IPS=
# Telegram backup channel (optional)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Optional AI cross-check for technical updates ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_EXTRACTION=on
AI_TIMEOUT_MS=10000

# ── Security ──
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=24
MFA_REQUIRED_ALL=false
TEMPLATE_SELF_APPROVAL=false
COOKIE_SECURE=true

# ── Worker ──
WORKER_POLL_MS=2000
WORKER_SWEEP_MS=30000
RUN_MIGRATIONS_ON_START=true

# ── Bootstrap (first run only) ──
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
